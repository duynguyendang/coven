// Coven Cloud on Cloudflare Workers (free plan): one Worker, one SQLite-backed Durable Object.
// Deploy: see infra/README.md ("Cloudflare Workers").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coven-cloud",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    // Every request goes through the Worker so the dashboard gets the same security headers as on Node.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "COVEN", "class_name": "CovenCloud" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CovenCloud"] }],
  "observability": { "enabled": true },
  // Which deployed version runs: the Durable Object restarts itself when the Worker in front of it is newer.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // `wrangler dev` only. Local tokens go in .dev.vars (ignored by git), never in this file.
  "dev": { "ip": "127.0.0.1", "port": 8788 }
}
