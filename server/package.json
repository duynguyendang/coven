{
  "name": "coven-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Coven Cloud: ingest, read models and live updates for Kiro coding-agent telemetry",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "seed": "node src/seed.ts",
    "check": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "jsdom": "24.1.3",
    "typescript": "5.9.3"
  }
}
